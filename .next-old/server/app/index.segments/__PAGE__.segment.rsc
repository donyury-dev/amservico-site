e:["$","$L26",null,{"id":"diferenciais","title":"Diferenciais","headline":"Estrutura preparada para contratos hospitalares exigentes.","description":"Solidez técnica, organização operacional e preparo institucional para cada projeto.","image":"https://www.amservico.com.br/assets/img/diferenciais-hospital.png","imageAlt":"Ambiente hospitalar moderno com infraestrutura de alta tecnologia","items":[{"icon":"Users","title":"Equipe especializada","text":"Atuação com linguagem e escopo alinhados ao ambiente hospitalar e diagnóstico por imagem."},{"icon":"Headset","title":"Atendimento técnico","text":"Suporte especializado com foco em disponibilidade, segurança e organização operacional."},{"icon":"HardHat","title":"Engenharia hospitalar","text":"União entre manutenção, preparação de ambientes e leitura técnica do parque."},{"icon":"BarChart3","title":"Gestão de indicadores","text":"Visão para contratos, históricos e acompanhamento de desempenho operacional."},{"icon":"Clock","title":"SLA e controle operacional","text":"Abordagem comercial com previsibilidade de atendimento e resposta a equipamentos críticos."},{"icon":"Building","title":"Suporte a grandes contratos","text":"Visual, narrativa e estrutura voltados a solidez, organização e prontidão institucional."}],"testimonials":[{"quote":"Há anos contamos com a AM Serviço e Manutenção para a manutenção dos nossos equipamentos de tomografia e raio X.","author":"João Mendes","role":"Diretor de Clínica Médica"},{"quote":"O suporte oferecido é excepcional. A atenção aos detalhes e a preocupação com a segurança fazem toda a diferença.","author":"Ricardo Lima","role":"Engenheiro Clínico"}]}]
